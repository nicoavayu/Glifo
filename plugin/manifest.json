{
  "manifestVersion": 5,
  "id": "com.pluginsubs.transcribir-mejor",
  "name": "Transcribir mejor",
  "version": "0.0.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": ["http://localhost:3001"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "transcribir-mejor-panel",
      "label": {
        "default": "Transcribir mejor"
      },
      "minimumSize": {
        "width": 280,
        "height": 220
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 500
      }
    }
  ]
}
